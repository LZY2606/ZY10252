# 固定 fixture：反应守恒审查台
# 数据口径见 README。原子下标从 0 开始；系数可写分数 n/d（如 1/2）。
# D/T 在展示时保留写法，语义归一为 H 的同位素（质量数 2/3）。

# ---------------------------------------------------------------------------
# R1 水的同位素交换：H2O + D -> HDO + H
# 系数全为 1；两个 H 对称 => 存在两个等价的原始映射，必须归并为同一等价类。
# 该反应元素/同位素/电荷全部守恒（无需修复）。
# ---------------------------------------------------------------------------
reaction R1
  reactant H2O
  reactant D
  product HDO
  product H
  map
    H2O:0 -> HDO:0
    H2O:1 -> HDO:2
    H2O:2 -> H:0
    D:0 -> HDO:1
  end
  map
    H2O:0 -> HDO:0
    H2O:1 -> H:0
    H2O:2 -> HDO:2
    D:0 -> HDO:1
  end
end

# ---------------------------------------------------------------------------
# R2 分数计量的元素守恒：NO + 1/2 O2 -> NO2
# 分数以有理数保存，按有理数核对，不用浮点容差。
# ---------------------------------------------------------------------------
reaction R2
  reactant NO
  reactant O2 1/2
  product NO2
end

# ---------------------------------------------------------------------------
# R3 遗漏小分子：NO -> NO2（缺少 1 个 O）
# 候选枚举应给出“向反应物补 1/2 O2”（分数惩罚）与等价的整数修复思路中
# 只允许补入分子：1/2 O2 是唯一单分子解；两分子解不存在。
# ---------------------------------------------------------------------------
reaction R3
  reactant NO
  product NO2
end

# ---------------------------------------------------------------------------
# R4 电荷守恒（半反应视角）：Fe2+ -> Fe3+ + e-
# ---------------------------------------------------------------------------
reaction R4
  reactant Fe2+
  product Fe3+
  product e-
end

# ---------------------------------------------------------------------------
# R5 遗漏电子（电荷不守恒）：Fe2+ -> Fe3+，缺一个电子。
# ---------------------------------------------------------------------------
reaction R5
  reactant Fe2+
  product Fe3+
end

# ---------------------------------------------------------------------------
# N1 小型网络：方向分支不同时保留多个中间体流量解。
#   R6: A -> X      （固定方向）
#   R7: X -> B      （方向未定）
#   R8: X -> B      （方向未定，与 R7 并列）
# 稳态要求中间体 X 净通量为 0；在有界网格 {0,1/2,1} 上：
#   forward/forward 分支有 f6=1,f7+f8=1 的三个解；
#   reverse/reverse 分支有 f6=0 的零流解；混合分支亦有零流解。
# ---------------------------------------------------------------------------
reaction R6
  reactant A
  product X
end

reaction R7
  reactant X
  product B
  direction unknown
end

reaction R8
  reactant X
  product B
  direction unknown
end

network N1
  step R6
  step R7 unknown
  step R8 unknown
end
